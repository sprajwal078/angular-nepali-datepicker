{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-nepali-datepicker-core": {
      "projectType": "library",
      "root": "projects/ngx-nepali-datepicker-core",
      "sourceRoot": "projects/ngx-nepali-datepicker-core/src",
      "prefix": "ndp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ngx-nepali-datepicker-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-nepali-datepicker-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-nepali-datepicker-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ngx-nepali-datepicker-core/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-nepali-datepicker-core/**/*.ts",
              "projects/ngx-nepali-datepicker-core/**/*.html"
            ]
          }
        }
      }
    },
    "ngx-nepali-datepicker-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/ngx-nepali-datepicker-demo",
      "sourceRoot": "projects/ngx-nepali-datepicker-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/ngx-nepali-datepicker-demo",
            "index": "projects/ngx-nepali-datepicker-demo/src/index.html",
            "browser": "projects/ngx-nepali-datepicker-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/ngx-nepali-datepicker-demo/tsconfig.app.json",
            "assets": [
              "projects/ngx-nepali-datepicker-demo/src/favicon.ico",
              "projects/ngx-nepali-datepicker-demo/src/assets"
            ],
            "styles": [
              "projects/ngx-nepali-datepicker-demo/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-nepali-datepicker-demo:build:production"
            },
            "development": {
              "buildTarget": "ngx-nepali-datepicker-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/ngx-nepali-datepicker-demo/tsconfig.spec.json",
            "assets": [
              "projects/ngx-nepali-datepicker-demo/src/favicon.ico",
              "projects/ngx-nepali-datepicker-demo/src/assets"
            ],
            "styles": [
              "projects/ngx-nepali-datepicker-demo/src/styles.css"
            ],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-nepali-datepicker-demo/**/*.ts",
              "projects/ngx-nepali-datepicker-demo/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      // "@angular-eslint/schematics" // Commented out
    ]
  }
}
